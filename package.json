{
  "name": "egant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:1421": "VITE_PORT=1421 vite",
    "build": "tsc --noEmit && vite build && npm run build:mobile",
    "build:mobile": "tsc --noEmit -p mobile/tsconfig.json && vite build --config mobile/vite.config.ts",
    "dev:mobile": "vite --config mobile/vite.config.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev:1421": "VITE_PORT=1421 tauri dev --config '{\"build\":{\"devUrl\":\"http://localhost:1421\",\"beforeDevCommand\":\"npm run dev:1421\"}}'"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "^2.5.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cuelume": "^0.2.4",
    "diff": "^9.0.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/diff": "^7.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "tailwindcss": "^4",
    "typescript": "~5.9",
    "vite": "^8"
  }
}
