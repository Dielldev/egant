{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "egant",
  "version": "0.1.10",
  "identifier": "com.egant.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "egant",
        "width": 1320,
        "height": 860,
        "minWidth": 880,
        "minHeight": 560,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3MkVFMEFCMTgwNUI0OTkKUldTWnRBVVlxK0F1bDMyV3NzcXNXYnhLUDlxZGVwMXE3RDlVZDNpTjdJVnNUWHMvM0VBRkdPV2UK",
      "endpoints": [
        "https://github.com/Dielldev/egant/releases/latest/download/latest.json"
      ]
    }
  }
}
